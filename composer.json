{
    "name": "processhub/laravel-logs",
    "description": "ProcessHub centralized logging for Laravel applications — ships logs, exceptions, and deploy markers to ProcessHub's /api/ingest endpoints",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "logging", "observability", "monolog", "exceptions"],
    "homepage": "https://processhub.io",
    "authors": [
        {
            "name": "ProcessHub Team",
            "homepage": "https://processhub.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "monolog/monolog": "^3.0",
        "guzzlehttp/guzzle": "^7.5"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "larastan/larastan": "^2.9|^3.0",
        "phpstan/phpstan": "^1.11|^2.0"
    },
    "autoload": {
        "psr-4": {
            "ProcessHub\\Logs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ProcessHub\\Logs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "check": [
            "@test",
            "@stan"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ProcessHub\\Logs\\ProcessHubServiceProvider"
            ],
            "aliases": {
                "ProcessHub": "ProcessHub\\Logs\\ProcessHub"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
